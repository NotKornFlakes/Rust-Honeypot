/target

# Logs hold IP addresses and passwords people try. Never commit them.
/logs/
*.log
*.jsonl

# The analysis notebook's Python environment and outputs. Exported charts stay here until you copy
# them out on purpose, and .gitattributes strips the notebook's own outputs on commit.
/.venv/
/analysis/figures/
.ipynb_checkpoints/
__pycache__/

# Terraform's working files. They name your project and your server's address.
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
